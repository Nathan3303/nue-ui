{
    "name": "@nue-ui/repo",
    "version": "0.2.4",
    "description": "NueUI repo",
    "author": "Nathan Lee",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "npx eslint -c eslint.config.mjs",
        "lint-on-debug": "npx eslint -c eslint.config.mjs --debug",
        "lint:lint-staged": "lint-staged",
        "format": "prettier --write --config .prettierrc .",
        "prepare": "husky",
        "core": "pnpm --filter nue-ui",
        "document": "pnpm --filter @nue-ui/document",
        "playground": "pnpm --filter @nue-ui/playground",
        "shadlike-theme": "pnpm --filter nue-ui-theme-shadlike",
        "iconfont": "pnpm --filter nue-ui-iconfont",
        "build": "pnpm core build && pnpm shadlike-theme build && pnpm iconfont build"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,css,scss,md}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Nathan3303/nue-ui"
    },
    "keywords": [
        "nue-ui",
        "ui-components",
        "vue3",
        "typescript"
    ],
    "devDependencies": {
        "@eslint/js": "^9.29.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/user-event": "^14.6.1",
        "@testing-library/vue": "^8.1.0",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^20.19.1",
        "@types/shelljs": "^0.8.16",
        "@typescript-eslint/eslint-plugin": "^8.34.1",
        "@typescript-eslint/parser": "^8.34.1",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitejs/plugin-vue-jsx": "^4.2.0",
        "@vitest/coverage-v8": "^4.1.1",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.5.1",
        "cross-env": "^7.0.3",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.0",
        "eslint-plugin-vue": "^9.33.0",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "jsdom": "^29.0.1",
        "lint-staged": "^15.5.2",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.6",
        "postcss-color-mix": "^1.1.0",
        "postcss-each": "^1.1.0",
        "postcss-each-variables": "^0.3.0",
        "postcss-for": "^2.1.1",
        "postcss-nested": "^6.2.0",
        "prettier": "^3.5.3",
        "shelljs": "^0.8.5",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.34.1",
        "vite": "6.3.4",
        "vitest": "3.0.5",
        "vue-tsc": "^1.8.27"
    },
    "dependencies": {
        "@nue-ui/components": "workspace:*",
        "@nue-ui/hooks": "workspace:*",
        "@nue-ui/plugins": "workspace:*",
        "@nue-ui/themes": "workspace:*",
        "@nue-ui/utils": "workspace:*",
        "lodash-es": "^4.17.21",
        "nue-ui": "workspace:*",
        "nue-ui-iconfont": "workspace:*",
        "nue-ui-resolver": "workspace:*",
        "nue-ui-theme-shadlike": "workspace:*",
        "vue": "^3.5.17"
    }
}
