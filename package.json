{
    "name": "@nue-ui/repo",
    "version": "0.4.0",
    "description": "NueUI repo",
    "author": "Nathan Lee",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "test": "vp test",
        "test:ui": "vp test --ui",
        "test:run": "vp test run",
        "test:coverage": "vp test run --coverage",
        "lint:lint-staged": "vp staged",
        "format": "vp fmt .",
        "prepare": "vp config",
        "core": "pnpm --filter nue-ui",
        "document": "pnpm --filter @nue-ui/document",
        "playground": "pnpm --filter @nue-ui/playground",
        "shadlike-theme": "pnpm --filter nue-ui-theme-shadlike",
        "iconfont": "pnpm --filter nue-ui-iconfont",
        "build": "pnpm core build && pnpm shadlike-theme build && pnpm iconfont build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Nathan3303/nue-ui"
    },
    "keywords": [
        "nue-ui",
        "ui-components",
        "vue3",
        "typescript"
    ],
    "devDependencies": {
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/user-event": "^14.6.1",
        "@testing-library/vue": "^8.1.0",
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^20.19.1",
        "@types/shelljs": "^0.8.16",
        "@vitejs/plugin-vue": "^5.2.4",
        "@vitejs/plugin-vue-jsx": "^4.2.0",
        "@vitest/coverage-v8": "catalog:",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.5.1",
        "baseline-browser-mapping": "^2.10.30",
        "cross-env": "^7.0.3",
        "globals": "^15.15.0",
        "jsdom": "^29.0.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.6",
        "postcss-color-mix": "^1.1.0",
        "postcss-each": "^1.1.0",
        "postcss-each-variables": "^0.3.0",
        "postcss-for": "^2.1.1",
        "postcss-nested": "^6.2.0",
        "shelljs": "^0.8.5",
        "typescript": "^5.8.3",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vue-tsc": "^1.8.27",
        "vite-plus": "catalog:"
    },
    "dependencies": {
        "@nue-ui/components": "workspace:*",
        "@nue-ui/hooks": "workspace:*",
        "@nue-ui/plugins": "workspace:*",
        "@nue-ui/themes": "workspace:*",
        "@nue-ui/utils": "workspace:*",
        "lodash-es": "^4.17.21",
        "nue-ui": "workspace:*",
        "nue-ui-iconfont": "workspace:*",
        "nue-ui-resolver": "workspace:*",
        "nue-ui-theme-shadlike": "workspace:*",
        "vue": "^3.5.17"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "11.21.0",
            "onFail": "download"
        }
    }
}